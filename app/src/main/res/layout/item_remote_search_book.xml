<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:paddingLeft="16dp"
    android:paddingTop="12dp"
    android:paddingRight="16dp"
    android:paddingBottom="12dp">

    <ImageView
        android:id="@+id/iv_item_cover"
        android:layout_width="82dp"
        android:layout_height="112dp"
        android:scaleType="fitXY"
        android:src="@drawable/pic_placeholder"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_item_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/black_text"
        android:textSize="17sp"
        app:layout_constraintLeft_toRightOf="@+id/iv_item_cover"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/iv_item_cover"
        tools:text="傲视电渗" />

    <TextView
        android:id="@+id/tv_item_author"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/black_text_light"
        android:textSize="13sp"
        app:layout_constraintLeft_toRightOf="@+id/iv_item_cover"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_item_name"
        tools:text="作者：寂小贼" />

    <TextView
        android:id="@+id/tv_item_source"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/text_grey"
        android:textSize="12sp"
        app:layout_constraintLeft_toRightOf="@+id/iv_item_cover"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_item_author"
        tools:text="来源：测试书源" />

    <TextView
        android:id="@+id/tv_item_category"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/text_grey"
        android:textSize="12sp"
        app:layout_constraintLeft_toRightOf="@+id/iv_item_cover"
        app:layout_constraintRight_toLeftOf="@+id/tv_item_status"
        app:layout_constraintTop_toBottomOf="@+id/tv_item_source"
        tools:text="分类：玄幻" />

    <TextView
        android:id="@+id/tv_item_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/main_color"
        android:textSize="12sp"
        app:layout_constraintBaseline_toBaselineOf="@+id/tv_item_category"
        app:layout_constraintRight_toRightOf="parent"
        tools:text="状态：连载" />

    <TextView
        android:id="@+id/tv_item_word_count"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/text_grey"
        android:textSize="12sp"
        app:layout_constraintLeft_toRightOf="@+id/iv_item_cover"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_item_category"
        tools:text="字数：3200字" />

    <TextView
        android:id="@+id/tv_item_latest_chapter"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/text_grey"
        android:textSize="12sp"
        app:layout_constraintLeft_toRightOf="@+id/iv_item_cover"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_item_word_count"
        tools:text="最新：第十章 新线索" />

    <TextView
        android:id="@+id/tv_item_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/colorDesTitle"
        android:textSize="13sp"
        app:layout_constraintLeft_toLeftOf="@+id/tv_item_name"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_item_latest_chapter"
        tools:text="废柴少年得无上传承，获逆天神脉，学绝世神功。" />

    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="@color/list_item_division"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_item_desc" />
</androidx.constraintlayout.widget.ConstraintLayout>
